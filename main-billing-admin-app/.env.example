# =====================================================================
# ITHI POORAM (ഇത്തിപ്പൂരം) — Environment Template (.env.local)
# =====================================================================

# 1. Telegram Bot Token (Get this from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# 2. Telegram Group Chat ID (Starts with -100 for private supergroups)
TELEGRAM_CHAT_ID="your_telegram_group_chat_id_here"

# Customer Mobile Ordering App Base URL
NEXT_PUBLIC_CUSTOMER_APP_URL="https://customer-mobile-ithipooram.vercel.app"
